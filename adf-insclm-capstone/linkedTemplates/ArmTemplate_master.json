{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-insclm-capstone"
		},
		"LS_ADLS_FromKV_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://stinsclmcap11.dfs.core.windows.net"
		},
		"LS_AzureSQL_FromKV_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "sql-insclm-cap-11.database.windows.net"
		},
		"LS_AzureSQL_FromKV_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "sqldb-insclm-capstone"
		},
		"LS_Databricks_FromKV_properties_typeProperties_existingClusterId": {
			"type": "string",
			"defaultValue": "0521-072004-qkvwqtnm"
		},
		"LS_KeyVault_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://kv-insclm-cap-11.vault.azure.net/"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adf-insclm-capstone_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"LS_AzureSQL_FromKV_properties_typeProperties_server": {
						"value": "[parameters('LS_AzureSQL_FromKV_properties_typeProperties_server')]"
					},
					"LS_AzureSQL_FromKV_properties_typeProperties_database": {
						"value": "[parameters('LS_AzureSQL_FromKV_properties_typeProperties_database')]"
					},
					"LS_KeyVault_properties_typeProperties_baseUrl": {
						"value": "[parameters('LS_KeyVault_properties_typeProperties_baseUrl')]"
					},
					"LS_ADLS_FromKV_properties_typeProperties_url": {
						"value": "[parameters('LS_ADLS_FromKV_properties_typeProperties_url')]"
					},
					"LS_Databricks_FromKV_properties_typeProperties_existingClusterId": {
						"value": "[parameters('LS_Databricks_FromKV_properties_typeProperties_existingClusterId')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}